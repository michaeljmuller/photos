FROM node:22-alpine

WORKDIR /app

# Build tools required to compile native modules (better-sqlite3) when
# prebuilt binaries are unavailable for the target platform.
RUN apk add --no-cache python3 make g++

# Install web lib dependencies (better-sqlite3, bcryptjs, jose, etc.)
COPY web/package*.json ./web/
RUN cd web && npm install --legacy-peer-deps

# Install test runner dependencies (vitest, type stubs)
COPY tests/package*.json ./tests/
RUN cd tests && npm install

# Copy only the library source and tests — no Next.js build needed
COPY web/lib ./web/lib
COPY tests/ ./tests/

CMD ["node", "tests/node_modules/.bin/vitest", "run", "--config", "tests/vitest.config.ts"]
